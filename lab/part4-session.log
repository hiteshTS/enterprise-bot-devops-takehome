    app.kubernetes.io/part-of: eb-debug-lab
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: debug-lab-2.0.0
spec:
  backoffLimit: 2
  template:
    metadata:
      labels:
        app: migrate
    spec:
      restartPolicy: Always
      containers:
        - name: migrate
          image: "docker.io/ebinterview/eb-debug-app:1.0.1"
          imagePullPolicy: IfNotPresent
          env:
            - name: APP_MODE
              value: "migrate"
            - name: APP_NAME
              value: "migrate"
            - name: VERSION
              value: "2.0.0"
          securityContext:
            runAsNonRoot: true
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop: ["ALL"]
          resources:
            requests:
              cpu: "50m"
              memory: "64Mi"
            limits:
              cpu: "200m"
              memory: "128Mi"
